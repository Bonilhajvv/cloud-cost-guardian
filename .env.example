NODE_ENV=development
PORT=3000
LOG_JSON=false
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://ccg:ccg@localhost:5432/ccg
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=7d

AWS_REGION=us-east-1
AWS_PLATFORM_ACCOUNT_ID=123456789012
AWS_ASSUME_ROLE_DURATION_SECONDS=3600
AWS_MAX_ATTEMPTS=6

JOBS_ENABLED=true

SUPER_ADMIN_EMAIL=admin@cloudcostguardian.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
PUBLIC_API_URL=http://localhost:3000
AGENT_TOKEN_SECRET=change-me-agent-token-secret-at-least-32-chars
K8S_AGENT_IMAGE=ghcr.io/your-org/ccg-k8s-agent:0.1.0
K8S_AGENT_HELM_CHART=oci://ghcr.io/your-org/charts/ccg-k8s-agent
CFN_TEMPLATE_URL=
